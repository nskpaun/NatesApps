   ]
  },
  {
   "id": "dock",
   "name": "Laptop dock",
   "summary": "Open right-wing cradle: guide the laptop in, its own weight seats it on a sprung USB-C, lift it straight out.",
   "description": "The dock wing rises 120 mm at the back and sweeps down in a concave curve to a 60 mm front, wrapped in brushed oxblood panels. A 20 mm slot with 4 mm lead-in chamfers guides a closed laptop in on its side, its own weight (about 13 N) seats it on a sprung, self-centring USB-C plug standing up from the slot floor, and to undock you simply lift it straight out. It works because the slot walls hold the laptop upright, so the plug only carries power and data and is never levered, while USB-C's own retention (roughly 8–20 N) keeps it connected. A slim amber light on the front face glows while the laptop is seated.",
   "parts": [
    "dock_cradle",
    "dock_panels",
    "dock_led",
    "dock_connector"
   ],
   "pivot": [
    0.7125,
    -0.0,
    0.0
   ],
   "bbox_mm": [
    125.0,
    120.0,
    260.0
   ],
   "mass_g": 2942.0,
   "volume_cm3": 680.4,
   "materials": [
    "titanium",
    "oxblood",
    "amber_led",
    "steel"
   ]
  },
  {
   "id": "laptop",
   "name": "Laptop",
   "summary": "A slim laptop (up to about 19 mm) that stands closed in the dock on its own USB-C port: your hardware.",
   "description": "A generic 14-inch class laptop (304 × 212 × 15 mm, about 1.3 kg) stands closed on its left side, hinge toward the back. Set it in and its weight seats its USB-C port on the dock's sprung connector; lift it straight out to take it with you. Docked, it drives the dual display and charges; lifted out, the station keeps running on the compute in the base. Mass is an estimate for a real device.",
