 "groups": [
  {
   "id": "display",
   "name": "Dual 27″ display",
   "summary": "Two mainstream 27″ QHD panels, toed in 10°, one 5120 × 1440 canvas with an honest titanium seam.",
   "description": "Two off-the-shelf 27″ 2560 × 1440 IPS monitors are stripped of their plastic housings, and their LCD modules hang on one steel VESA spine inside a shared graphite shroud. Each panel is toed in 10° about the seam, so the outer edges come 106 mm toward you and the 1.2 m wide canvas wraps your field of view like a 49-inch super-ultrawide. The 14 mm gap between the active areas is not hidden: a 4 mm titanium mullion runs the full height of the glass, and your OS already treats it as the border between two displays. A dead panel is a cheap swap, not a new monitor.",
   "parts": [
    "display_screen",
    "display_glass",
    "display_seam",
    "display_frame",
    "display_back",
    "display_spine",
    "display_boards"
   ],
   "pivot": [
    0.0,
    0.153,
    -0.048645
   ],
   "bbox_mm": [
    1218.2,
    366.7,
    188.7
   ],
   "mass_g": 12176.4,
   "volume_cm3": 7322.7,
   "materials": [
    "screen",
    "glass_black",
    "titanium",
    "graphite",
    "steel",
    "pcb"
   ]
  },
  {
   "id": "stand",
   "name": "Neck & light bar",
   "summary": "Trapezoid aluminium neck that carries the display and the cables, with the amber light bar under the screen.",
   "description": "A hollow trapezoid neck (320 mm at the foot, 180 mm at the top) leans back 4.8° and plugs 3 mm into the display's keel, so the steel spine sits directly on it. The hollow core is the cable chase from the compute board to the monitors' scaler boards. NIGHT ARRAY is inlaid in titanium on the front face, and an amber light bar glows on the neck face just below the display.",
   "parts": [
    "neck",
    "neck_light",
    "neck_badge"
   ],
   "pivot": [
    -0.0,
    0.036,
    -0.104948
   ],
   "bbox_mm": [
    320.0,
    120.0,
    69.9
   ],
   "mass_g": 787.0,
   "volume_cm3": 292.7,
   "materials": [
    "graphite",
    "amber_led",
    "titanium"
   ]
  },
  {
   "id": "base",
   "name": "Base & charging trays",
   "summary": "1.29 m machined titanium tray with a recessed deck and two Qi2 charging pockets.",
   "description": "The base is one long titanium tray: a 16 mm rim, a deck recessed 6 mm, and two pockets that sink the keyboard to about deck level (its keycaps stay just below the rim) and cradle the mouse. Soft-touch polymer pads cover non-metallic windows in the pocket floors, because titanium would block Qi2; set a device down and it charges. Amber indicators sit on the front lip, an under-glow strip lights the desk, and the shell is hollow inside to hold the compute, power and coils. Rear I/O and the exhaust grille are on the back face, left side.",
   "parts": [
    "base_shell",
    "deck_liner",
    "tray_pad_kb",
    "tray_pad_mouse",
    "base_glow",
    "kb_charge_led",
    "mouse_charge_led",
    "base_feet"
   ],
   "pivot": [
    0.005,
